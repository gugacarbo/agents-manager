{
	"name": "agents-manager",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"dev:web": "vite",
		"build": "tauri build",
		"build:web": "vite build",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:md": "prettier --write \"**/*.{md,yml,yaml,sh}\"",
		"format:check": "prettier --check \"**/*.{md,yml,yaml,sh}\"",
		"check": "biome check . && tsc --noEmit && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
		"check:boundaries": "bun scripts/check-feature-boundaries.ts",
		"check:component-size": "bun scripts/check-component-size.ts",
		"check:style-drift": "bun scripts/check-style-drift.ts",
		"check:story-coverage": "bun scripts/check-story-coverage.ts",
		"check:tanstack": "bun scripts/check-tanstack-conventions.ts",
		"check:design-system": "bun scripts/check-design-system.ts",
		"check:guards": "bun scripts/validate.ts guards",
		"generate:ui-catalog": "bun scripts/generate-ui-catalog.ts",
		"test:ts": "vitest run",
		"test:rust": "cargo test --workspace",
		"test": "bun run --parallel test:ts test:rust",
		"test:storybook": "vitest run --config vitest.storybook.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"knip": "knip",
		"knip:report": "knip --no-exit-code",
		"spell": "cspell lint \"**/*.{ts,tsx,md,json,yaml,yml}\"",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"intent": "intent list",
		"validate:fast": "bun scripts/validate.ts fast",
		"validate": "bun scripts/validate.ts local",
		"prepare": "husky"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.2",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/merge": "^6.13.0",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.2",
		"@tanstack/react-form": "^1.33.6",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-table": "^9.3.1",
		"@tauri-apps/api": "^2.12.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.81.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-resizable-panels": "^4.24.3",
		"smol-toml": "^1.9.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1",
		"zod": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@cspell/dict-pt-br": "^2.4.4",
		"@playwright/test": "^1",
		"@storybook/addon-vitest": "^10.6.9",
		"@storybook/react-vite": "^10.6.9",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/intent": "^0.5.6",
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/browser-playwright": "^5.1.2",
		"cspell": "^10",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"knip": "^6",
		"lint-staged": "^17.6.2",
		"prettier": "^3",
		"prettier-plugin-sh": "^0.20.2",
		"storybook": "^10.6.9",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.4.0",
		"vitest": "^5.1.2"
	}
}
