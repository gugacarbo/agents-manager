{
	"name": "agents-manager",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"dev:web": "vite",
		"build": "tauri build",
		"build:web": "vite build",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:md": "prettier --write \"**/*.{md,yml,yaml,sh}\"",
		"format:check": "prettier --check \"**/*.{md,yml,yaml,sh}\"",
		"check": "biome check . && tsc --noEmit && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
		"test:ts": "vitest run",
		"test:rust": "cargo test --workspace",
		"test": "bun run --parallel test:ts test:rust",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"knip": "knip",
		"knip:report": "knip --no-exit-code",
		"spell": "cspell lint \"**/*.{ts,tsx,md,json,yaml,yml}\"",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx}": [
			"biome check --write --no-errors-on-unmatched",
			"cspell --no-must-find-files"
		],
		"*.{md,yml,yaml,sh}": [
			"prettier --write",
			"cspell --no-must-find-files"
		],
		"*.rs": [
			"rustfmt --edition 2024"
		]
	},
	"dependencies": {
		"@tanstack/react-query": "^5.108.4",
		"@tauri-apps/api": "^2.12.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@cspell/dict-pt-br": "^2.4.4",
		"@playwright/test": "^1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"cspell": "^10",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"knip": "^6",
		"lint-staged": "^17.6.2",
		"prettier": "^3",
		"prettier-plugin-sh": "^0.20.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.4.0",
		"vitest": "^5.1.2"
	}
}
