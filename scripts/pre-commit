#!/usr/bin/env bash
set -euo pipefail

current_step="initialization"
on_err() {
	local exit_code=$?
	echo "pre-commit failed at step: ${current_step} (exit ${exit_code})" >&2
	exit "$exit_code"
}
trap on_err ERR

top="$(git rev-parse --show-toplevel)"
cd "$top"

current_step="git diff --check"
git diff --check

current_step="CASA index regeneration"
staged_docs="$(git diff --cached --name-only | grep -E '^docs/(adr|specs)/[0-9]{4}-[^/]+\.md$' || true)"
if [ -n "$staged_docs" ]; then
	unstaged_docs="$(
		{
			git diff --name-only
			git ls-files --others --exclude-standard
		} | grep -E '^docs/(adr|specs)/[0-9]{4}-[^/]+\.md$' || true
	)"
	if [ -n "$unstaged_docs" ]; then
		echo "pre-commit: ADR/Spec files have unstaged or untracked changes:" >&2
		echo "$unstaged_docs" >&2
		exit 1
	fi

	python3 scripts/docs-check --emit-index

	generated_indices=()
	for index_file in docs/index.json docs/adr/README.md docs/specs/README.md; do
		if [ -f "$index_file" ]; then
			generated_indices+=("$index_file")
		fi
	done
	if [ "${#generated_indices[@]}" -gt 0 ]; then
		git add -- "${generated_indices[@]}"
	fi
fi

current_step="scripts/docs-check --staged"
python3 scripts/docs-check --staged

current_step="gitleaks"
gitleaks git --pre-commit --staged --redact --verbose

current_step="lint-staged"
bunx lint-staged
