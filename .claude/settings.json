{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write",
				"hooks": [
					{
						"type": "command",
						"command": "bun scripts/claude-hooks/pre-write-new-component.ts"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bun scripts/claude-hooks/post-edit-ui.ts"
					}
				]
			}
		]
	}
}
